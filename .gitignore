# Data (competition files — keep out of git, but preserve folder structure)
# Everything under data/ is ignored except the .gitkeep placeholders.
data/**
!data/
!data/**/
!data/**/.gitkeep

# NOTE: outputs/ is intentionally NOT ignored — charts (PNG/HTML) are committed.

# Python
__pycache__/
*.py[cod]
*$py.class
.ipynb_checkpoints/
.venv/
venv/
env/
*.egg-info/
.eggs/
dist/
build/

# Notebooks output
*.nbconvert.ipynb

# Environment / secrets
.env
.env.local

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
