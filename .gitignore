# Data (large / competition files — keep out of git, but preserve folder structure)
data/raw/*
data/interim/*
data/processed/*
!data/raw/.gitkeep
!data/interim/.gitkeep
!data/processed/.gitkeep
*.csv
*.parquet
*.feather

# Python
__pycache__/
*.py[cod]
*$py.class
.ipynb_checkpoints/
.venv/
venv/
env/
*.egg-info/
.eggs/
dist/
build/

# Notebooks output
*.nbconvert.ipynb

# Environment / secrets
.env
.env.local

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
